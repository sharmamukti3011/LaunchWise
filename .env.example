# Copy to .env and fill in real values. Never commit .env.
# On the server, .env lives next to docker-compose.yml and is loaded via env_file only.

# --- App ---------------------------------------------------------------------------------------
# docker-compose.yml forces APP_ENV=production, CORS_ALLOWED_ORIGIN and DATABASE_PATH for the
# containers, so these three only matter for local development.
APP_ENV=development
CORS_ALLOWED_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/launchwise.db

# --- Claude ------------------------------------------------------------------------------------
# The model name comes from here, never from code.
ANTHROPIC_API_KEY=your-key-here
CLAUDE_MODEL=your-model-name-here
CLAUDE_MAX_CALLS_PER_SESSION=20
CLAUDE_MAX_CALLS_GLOBAL=500

# --- Contact form (GoDaddy mailbox) ------------------------------------------------------------
# The form works only when CONTACT_ENABLED=true AND every mailbox value below is real. If any is
# missing or still an example, the app still starts and the form answers "not configured".
# The startup log names which variables are missing (never their values).
CONTACT_ENABLED=false
# GoDaddy's outgoing mail server for this mailbox: smtpout.secureserver.net, port 465, SSL
# (confirmed by the owner). The 10-second timeout is fixed in code.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
# ssl (the default), starttls, or none. "none" is refused in production.
SMTP_SECURITY=ssl
# The mailbox that sends the mail. It is the From address; the visitor's address goes in Reply-To.
SMTP_USER=your-mailbox@example.invalid
# Never commit the real password. Set it only in the server-side .env.
SMTP_PASSWORD=changeme
# Where contact messages are delivered. Set here, never taken from the request.
CONTACT_RECIPIENT=your-mailbox@example.invalid
# Abuse limits for the contact form.
# Per visitor address: this many messages per window (here 5 per hour). Same visitor
# identification as the analyze endpoint.
CONTACT_RATE_LIMIT_PER_IP=5
CONTACT_RATE_WINDOW_SECONDS=3600
# Across all visitors: this many messages per window (here 200 per hour). It protects the
# mailbox from floods. It can be raised without a code change: edit these two values in .env,
# then run `docker compose up -d --force-recreate backend`.
CONTACT_RATE_LIMIT_GLOBAL=200
CONTACT_RATE_WINDOW_GLOBAL_SECONDS=3600

# --- Analyze endpoint -------------------------------------------------------------------------
# POST /api/analyze: requests allowed per visitor address per window (here 60 per minute).
ANALYZE_RATE_LIMIT_PER_IP=60
ANALYZE_RATE_WINDOW_SECONDS=60

# --- Starter pages -----------------------------------------------------------------------------
# How many pages one visitor may publish per hour, and how many example pages may be live at once.
# The seeded example page does not count toward the cap.
PUBLISH_LIMIT_PER_HOUR=3
MAX_LIVE_PAGES=50

# --- Deployment (read by docker compose, not by the app) ---------------------------------------
# The public domain. Caddy serves it, gets its HTTPS certificate, and redirects www to it.
# Use "localhost" for a local smoke test of the full stack.
SITE_DOMAIN=launchwise.pro
