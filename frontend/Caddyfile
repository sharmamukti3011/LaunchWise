# SITE_DOMAIN comes from the environment (docker-compose.yml); launchwise.pro is the default.
# Caddy obtains and renews the HTTPS certificates for both names automatically.

(security_headers) {
	header {
		# Short max-age while launch is being proven. Raise it once everything works (see README).
		# Deliberately no includeSubDomains and no preload.
		Strict-Transport-Security "max-age=300"
		X-Content-Type-Options "nosniff"
		# The site never uses these browser features, so a page (or a bug) cannot ask for them.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; frame-ancestors 'none'"
		-Server
	}
}

www.{$SITE_DOMAIN:launchwise.pro} {
	redir https://{$SITE_DOMAIN:launchwise.pro}{uri} permanent
}

{$SITE_DOMAIN:launchwise.pro} {
	encode zstd gzip

	import security_headers

	# The contact form is small. Cap the body before it reaches the backend. This block must stay
	# above /api/*: Caddy runs the first matching handle.
	handle /api/contact {
		request_body {
			max_size 16KB
		}
		reverse_proxy backend:8000
	}

	# The analyze request is a few KB of JSON. Same rule: this block stays above /api/*.
	handle /api/analyze {
		request_body {
			max_size 32KB
		}
		reverse_proxy backend:8000
	}

	# Explaining a visitor's own request carries the same JSON, so the same cap.
	handle /api/analyze/explain {
		request_body {
			max_size 32KB
		}
		reverse_proxy backend:8000
	}

	# A description is at most 1,500 characters. Same rule: this block stays above /api/*.
	handle /api/intake {
		request_body {
			max_size 8KB
		}
		reverse_proxy backend:8000
	}

	# A starter page request is a name, a short description and an offer. Same rule: above /api/*.
	handle /api/storefront/preview {
		request_body {
			max_size 4KB
		}
		reverse_proxy backend:8000
	}

	# Publishing and unpublishing carry an id and a hash, or a slug and a token: tiny bodies.
	@pageactions path /api/storefront/publish /api/storefront/unpublish
	handle @pageactions {
		request_body {
			max_size 1KB
		}
		reverse_proxy backend:8000
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	# Starter pages are served by the backend at /s/<slug>. The backend answers every address
	# itself (a live page, or its own "not available" 404), sets noindex and no-store, and the
	# security headers above still apply. Only GET reads anything here.
	handle /s/* {
		reverse_proxy backend:8000
	}

	# The 404 page is shown for unknown addresses. It is not an address you can visit itself.
	handle /404.html {
		error 404
	}

	# Only "/" renders the app. Real files (the built /assets/*) are served as they are. There is
	# no fallback to index.html: any other path is a real 404.
	handle {
		root * /srv
		file_server
	}

	# Caddy's own 404s (unknown paths) get the Page not found page, with its
	# status kept at 404. Only 404s: a backend outage (502) must not read "Page not found".
	# Error responses skip the site's `header` rules, so the security headers are repeated here.
	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			import security_headers
			root * /srv
			rewrite * /404.html
			file_server
		}
	}
}
